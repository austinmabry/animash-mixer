# Copy to .env.
# icons (default, local, needs data/icons from the scraper) | claude | ocr
VISION_BACKEND=icons
# Minimum match score for a tile to count (tune with scripts/match_debug.py)
MATCH_THRESHOLD=0.45
# Only needed for VISION_BACKEND=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-6
# How many mixes to show by default
TOP_N=5
# Port for the dev server (python -m app.server); Docker publishes 35000 -> 8080 regardless
PORT=35000
